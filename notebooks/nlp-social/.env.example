# Copy to .env (never commit it) or export these variables before starting Jupyter.
# Twitter / X API (developer portal -> your app -> Keys and tokens)
TWITTER_CONSUMER_KEY=
TWITTER_CONSUMER_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
# Reddit API (https://www.reddit.com/prefs/apps -> "script" app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=wsb-word-freq by <your-reddit-username>
